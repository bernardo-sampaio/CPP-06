CXX = c++
CXXFLAGS = -Wall -Wextra -Werror -std=c++98 
NAME = base
SRCS = main.cpp Base.cpp
OBJS = $(SRCS:.cpp=.o)
HEADER = Base.hpp A.hpp B.hpp C.hpp


all: $(NAME)

$(OBJS): $(HEADER)

$(NAME): $(OBJS)
	$(CXX) $(CXXFLAGS) $(OBJS) -o $(NAME)

clean:
	rm -f $(OBJS)

fclean: clean
	rm -f $(NAME)

re: fclean all

.PHONY: all clean fclean re
